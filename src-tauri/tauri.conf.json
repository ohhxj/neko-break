{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neko Break",
  "version": "0.1.0",
  "identifier": "com.reshui.mac-break-reminder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Neko Break",
        "width": 1160,
        "height": 800,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Break Time",
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/presets/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
